  <library_effects>
    <effect id="Hip_Rep...urus(1)-Effect">
      <profile_COMMON>
        <newparam sid="Hip_Rep...urus(1)-diffuse-surface">
          <surface type="2D">
            <init_from>Hip_Rep...urus(1)-diffuse-tex</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="Hip_Rep...urus(1)-emissive-surface">
          <surface type="2D">
            <init_from>Hip_Rep...urus(1)-emissive-tex</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="Hip_Rep...urus(1)-diffuse-sampler">
          <sampler2D>
            <source>Hip_Rep...urus(1)-diffuse-surface</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>NONE</magfilter>
            <mipfilter>NONE</mipfilter>
          </sampler2D>
        </newparam>
        <newparam sid="Hip_Rep...urus(1)-emissive-sampler">
          <sampler2D>
            <source>Hip_Rep...urus(1)-emissive-surface</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>NONE</magfilter>
            <mipfilter>NONE</mipfilter>
          </sampler2D>
        </newparam>
        <technique sid="phong1">
          <phong>
            <emission>
              <texture texcoord="Hip_Rep...urus(1)-tex-bind" texture="Hip_Rep...urus(1)-emissive-sampler"/>
            </emission>
            <ambient>
              <color>1.0 1.0 1.0 1.0</color>
            </ambient>
            <diffuse>
              <texture texcoord="Hip_Rep...urus(1)-tex-bind" texture="Hip_Rep...urus(1)-diffuse-sampler"/>
            </diffuse>
            <specular>
              <color>0.0 0.0 0.0 1.0</color>
            </specular>
            <shininess>
              <float>5.0</float>
            </shininess>
            <reflective>
              <color>1.0 1.0 1.0 1.0</color>
            </reflective>
            <reflectivity>
              <float>0.2</float>
            </reflectivity>
            <transparent>
              <color>1.0 1.0 1.0 1.0</color>
            </transparent>
            <transparency>
              <float>1.0</float>
            </transparency>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
