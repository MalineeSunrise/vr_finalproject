  <library_effects>
    <effect id="Hip_Large_Quadruped-Effect">
      <profile_COMMON>
        <newparam sid="Hip_Large_Quadruped-diffuse-surface">
          <surface type="2D">
            <init_from>Hip_Large_Quadruped-diffuse-tex</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="Hip_Large_Quadruped-emissive-surface">
          <surface type="2D">
            <init_from>Hip_Large_Quadruped-emissive-tex</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="Hip_Large_Quadruped-diffuse-sampler">
          <sampler2D>
            <source>Hip_Large_Quadruped-diffuse-surface</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>NONE</magfilter>
            <mipfilter>NONE</mipfilter>
          </sampler2D>
        </newparam>
        <newparam sid="Hip_Large_Quadruped-emissive-sampler">
          <sampler2D>
            <source>Hip_Large_Quadruped-emissive-surface</source>
            <wrap_s>CLAMP</wrap_s>
            <wrap_t>CLAMP</wrap_t>
            <minfilter>NONE</minfilter>
            <magfilter>NONE</magfilter>
            <mipfilter>NONE</mipfilter>
          </sampler2D>
        </newparam>
        <technique sid="phong1">
          <phong>
            <emission>
              <texture texcoord="Hip_Large_Quadruped-tex-bind" texture="Hip_Large_Quadruped-emissive-sampler"/>
            </emission>
            <ambient>
              <color>1.0 1.0 1.0 1.0</color>
            </ambient>
            <diffuse>
              <texture texcoord="Hip_Large_Quadruped-tex-bind" texture="Hip_Large_Quadruped-diffuse-sampler"/>
            </diffuse>
            <specular>
              <color>0.0 0.0 0.0 1.0</color>
            </specular>
            <shininess>
              <float>5.0</float>
            </shininess>
            <reflective>
              <color>1.0 1.0 1.0 1.0</color>
            </reflective>
            <reflectivity>
              <float>0.2</float>
            </reflectivity>
            <transparent>
              <color>1.0 1.0 1.0 1.0</color>
            </transparent>
            <transparency>
              <float>1.0</float>
            </transparency>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
